# Copy to .env (never commit .env). Only the names are listed here.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=b64c494f-f3b2-4168-a215-175ea7f69090
PRISMTRACE_HOST=https://api.prism.blockconvey.com
# Claude access: set ONE of these (LLM_PROVIDER=auto picks whichever is set)
ANTHROPIC_API_KEY=
NICRRON_API_KEY=
# LLM_PROVIDER=auto | anthropic | nicrron
LLM_PROVIDER=auto
NICRRON_MODEL=anthropic/claude-opus-5-5
# Optional: amount at or above which a human must decide
HUMAN_REVIEW_AMOUNT=1000000
# Secret salt for pseudonymising account ids sent to PRISM
MASK_SALT=
